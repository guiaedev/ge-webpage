---
import '../styles/global.css';
import {site} from '../data/site';
const {title = 'Guía Existencial | Psicoterapia en línea', base} = Astro.props;
---
<!doctype html><html lang="es-MX"><head><meta charset="UTF-8"/>{base && <base href={base}/>}<meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={site.description}/><meta name="theme-color" content="#faf7f0"/><meta property="og:title" content="Guía Existencial | Psicoterapia en línea"/><meta property="og:description" content={site.description}/><meta property="og:type" content="website"/><link rel="icon" type="image/svg+xml" href="assets/favicon.svg"/><link rel="icon" type="image/png" sizes="96x96" href="assets/favicon.png"/><title>{title}</title></head><body><a class="skip-link" href={base ? 'nosotras/#contenido' : '#contenido'}>Ir al contenido</a><slot/></body></html>
