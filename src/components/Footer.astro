---
import Mark from './Mark.astro';
import {site, bookingPolicies} from '../data/site';
import {legal, legalPages, legalContent} from '../data/legal';
const shortLabels: Record<string, string> = {'aviso-de-privacidad': 'Privacidad', terminos: 'Términos', consentimiento: 'Consentimiento'};
---
<footer class="site-footer" id="reservar"><div class="botanical-viewport" aria-hidden="true"><picture><source type="image/webp" srcset="assets/footer-watercolor-light-960.webp 960w, assets/footer-watercolor-light-1776.webp 1776w" sizes="100vw"/><img src="assets/footer-watercolor-light-1776.webp" alt="" loading="lazy" width="1776" height="888"/></picture></div><img class="footer-overlap-leaf" src="assets/footer-overlap-monstera.webp" alt="" aria-hidden="true" width="800" height="680" loading="lazy"/><img class="footer-overlap-branch" src="assets/footer-overlap-eucalyptus-fern.webp" alt="" aria-hidden="true" width="600" height="900" loading="lazy"/><div class="footer-fireflies" aria-hidden="true">
 {[[7,24,-1],[13,65,-3],[89,35,-2],[95,76,-4],[30,9,-2.5],[45,7,-4.2],[60,10,-1.7],[73,8,-3.6]].map(([x,y,delay],i) => <span style={`--x:${x}%;--y:${y}%;--delay:${delay}s;--pulse:${4.5+(i%4)*.6}s;--duration:${24+i*3}s`}/>)}
 </div><div class="footer-copy"><a class="brand footer-brand" href="#inicio"><Mark/>Guía Existencial</a>
 <div class="footer-info">
  <section aria-labelledby="footer-session"><h3 id="footer-session">Tu sesión</h3><ul><li>Psicoterapia en línea, 60 min</li><li>Pago seguro al reservar</li><li><a href={site.bookingUrl} data-booking data-booking-tab="first">Primera sesión</a> · <a href={site.followUpUrl} data-booking data-booking-tab="followup">Continuar mi proceso</a></li></ul></section>
  <section aria-labelledby="footer-agreements"><h3 id="footer-agreements">Acuerdos</h3><ul>{bookingPolicies.map(policy => <li>{policy.summary}</li>)}</ul></section>
  <nav aria-labelledby="footer-legal"><h3 id="footer-legal">Información</h3><ul>{legalPages.map(page => <li><a href={`${page.slug}/`} data-info-tab={page.slug}>{page.label}</a></li>)}<li><a href={site.contactUrl} data-info-tab="contacto">Contacto</a></li></ul></nav>
 </div>
 <p class="footer-crisis">{legal.crisis}</p>
 <small>© {new Date().getFullYear()} Guía Existencial</small><a class="footer-credit" href="https://ateliersintropia.com" target="_blank" rel="noopener"><span>Designed &amp; Engineered by</span><span class="footer-credit-brand" aria-label="Atelier Sintropia"><img src="assets/atelier-sintropia-mark.png" alt="" width="64" height="96" loading="lazy"/><span aria-hidden="true">ATELIER <b>SIN</b>TROPIA</span></span></a></div></footer>
<dialog id="info-dialog" class="content-dialog info-dialog" aria-labelledby="info-dialog-title">
 <button class="dialog-close" data-close aria-label="Cerrar">×</button>
 <p class="eyebrow" id="info-dialog-title">Información</p>
 <div class="info-tabs" role="tablist" aria-label="Información legal y contacto">
  {legalPages.map((page, index) => <button type="button" role="tab" id={`info-tab-${page.slug}`} aria-controls={`info-panel-${page.slug}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-tab={page.slug}>{shortLabels[page.slug] ?? page.label}</button>)}
  <button type="button" role="tab" id="info-tab-contacto" aria-controls="info-panel-contacto" aria-selected="false" tabindex="-1" data-tab="contacto">Contacto</button>
 </div>
 {legalPages.map((page, index) => { const content = legalContent[page.slug]; return (
  <section id={`info-panel-${page.slug}`} class="info-panel" role="tabpanel" aria-labelledby={`info-tab-${page.slug}`} tabindex="0" hidden={index !== 0}>
   <h2>{content.title}</h2><p class="info-intro">{content.intro}</p>
   {legal.mock && <p class="legal-draft" role="note">Borrador con datos de ejemplo. Este texto debe sustituirse por la versión definitiva revisada antes de publicar el sitio.</p>}
   {content.sections.map(section => <section class="legal-section"><h3>{section.title}</h3>{section.body.map(text => <p>{text}</p>)}</section>)}
   <p class="legal-updated">Última actualización: {legal.updated}</p>
  </section>); })}
 <section id="info-panel-contacto" class="info-panel" role="tabpanel" aria-labelledby="info-tab-contacto" tabindex="0" hidden>
  <h2>Contacto</h2>
  <p class="info-intro">¿Tienes dudas sobre las terapias, quieres agendar o reagendar una sesión? Escríbenos y el equipo te responderá.</p>
  <a class="button primary" href={site.contactUrl} target="_blank" rel="noopener">Ir al formulario de contacto <span aria-hidden="true">↗</span></a>
  <p class="info-crisis">{legal.crisis}</p>
 </section>
</dialog>
<script is:inline>
 // One dialog, tabbed: footer links open it on their tab; hrefs stay as the no-JS fallback.
 (() => {
  const dialog = document.getElementById('info-dialog');
  if (!dialog) return;
  const tabs = [...dialog.querySelectorAll('[role=tab]')];
  const select = (key, focus) => {
   tabs.forEach(tab => {
    const on = tab.dataset.tab === key;
    tab.setAttribute('aria-selected', String(on));
    tab.tabIndex = on ? 0 : -1;
    document.getElementById(tab.getAttribute('aria-controls')).hidden = !on;
    if (on && focus) tab.focus();
   });
   dialog.scrollTop = 0;
  };
  tabs.forEach(tab => tab.addEventListener('click', () => select(tab.dataset.tab)));
  dialog.querySelector('.info-tabs').addEventListener('keydown', event => {
   const index = tabs.findIndex(tab => tab.getAttribute('aria-selected') === 'true');
   const next = {ArrowRight: index + 1, ArrowLeft: index - 1, Home: 0, End: tabs.length - 1}[event.key];
   if (next === undefined) return;
   event.preventDefault();
   select(tabs[(next + tabs.length) % tabs.length].dataset.tab, true);
  });
  document.querySelectorAll('[data-info-tab]').forEach(link => link.addEventListener('click', event => {
   event.preventDefault();
   document.querySelectorAll('dialog[open]').forEach(other => other.close());
   select(link.dataset.infoTab);
   dialog.showModal();
  }));
  dialog.querySelector('[data-close]').addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
 })();
</script>

<script>
 document.querySelectorAll<HTMLElement>('.footer-fireflies span').forEach((light, index) => {
  light.addEventListener('animationiteration', event => {
   if(event.animationName !== 'firefly-glow') return;
   // Disjoint zones preserve spacing even when every light is visible.
   const zones = [[4,10,20,32],[8,14,62,76],[88,94,25,38],[90,96,68,82],
    [27,32,6,11],[42,47,6,11],[57,62,6,11],[72,77,6,11]];
   const [left,right,top,bottom] = zones[index];
   light.style.setProperty('--x', `${left + Math.random() * (right-left)}%`);
   light.style.setProperty('--y', `${top + Math.random() * (bottom-top)}%`);
  });
 });
</script>
