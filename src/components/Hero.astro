---
import BookingButton from './BookingButton.astro';
import TrustIcon from './TrustIcon.astro';
---
<section id="inicio" class="hero hero-character" aria-labelledby="hero-title">
 <div class="botanical-viewport" aria-hidden="true"><picture class="hero-art"><source type="image/webp" srcset="assets/hero-runway-960.webp 960w, assets/hero-runway-1776.webp 1776w" sizes="100vw"/><img src="assets/hero-runway-1776.webp" alt="" width="1776" height="753" fetchpriority="high"/></picture></div>
 <div class="hero-botanical-accents" aria-hidden="true"><img class="hero-accent-monstera" src="assets/footer-overlap-monstera.webp" alt="" width="800" height="800"/><img class="hero-accent-branch" src="assets/footer-overlap-eucalyptus-fern.webp" alt="" width="600" height="900"/></div>
 <div class="hero-copy"><p class="eyebrow">Psicoterapia en línea</p><h1 id="hero-title" class="hero-quote">Las personas tienen más poder del que creen para cambiar su forma de pensar y sentir.</h1><p class="hero-attribution"><cite>Aaron Beck</cite><small>Creador de la terapia cognitiva</small></p><div class="hero-actions"><BookingButton label="Agendar mi primera sesión" tab="first"/></div></div>
</section>
<div class="trust-strip" aria-label="Nuestra atención"><span><TrustIcon kind="evidence"/>Basada en evidencia</span><span><TrustIcon kind="personal"/>Atención personalizada</span><span><TrustIcon kind="online"/>100% en línea</span></div>
