---
import BookingButton from './BookingButton.astro';
import TrustIcon from './TrustIcon.astro';
---
<section id="inicio" class="hero" aria-labelledby="hero-title">
 <div class="botanical-viewport" aria-hidden="true"><picture class="hero-art"><source type="image/webp" srcset="assets/hero-watercolor-960.webp 960w, assets/hero-watercolor-1536.webp 1536w" sizes="100vw"/><img src="assets/hero-watercolor-1536.webp" alt="" width="1536" height="1024" fetchpriority="high"/></picture></div><span class="edge-leaf edge-leaf-left" aria-hidden="true"><img src="assets/foreground-watercolor.webp" alt="" width="400" height="400" loading="lazy"/></span><span class="edge-leaf edge-leaf-right" aria-hidden="true"><img src="assets/foreground-watercolor.webp" alt="" width="400" height="400" loading="lazy"/></span>
 <div class="hero-copy"><svg class="hero-conversation" viewBox="0 0 64 52" fill="none" aria-hidden="true" focusable="false"><path d="M36 23h12a9 9 0 0 1 9 9v5a9 9 0 0 1-9 9h-2l-7 4v-4h-3a9 9 0 0 1-9-9v-5a9 9 0 0 1 9-9Z" fill="#e5eadc" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M16 5h20a11 11 0 0 1 11 11v7a11 11 0 0 1-11 11H24l-10 6v-6A11 11 0 0 1 5 23v-7A11 11 0 0 1 16 5Z" fill="#fbf8f2" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M16 17h19M16 23h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><p class="eyebrow">Psicoterapia en línea</p><h1 id="hero-title" class="hero-quote">“Las personas tienen más poder del que creen para cambiar su forma de pensar y sentir.”</h1><p class="hero-attribution"><cite>Aaron Beck</cite></p><p class="hero-description">Psicoterapia en línea basada en evidencia y atención personalizada.</p><div class="hero-actions"><BookingButton label="Agendar mi primera sesión"/></div></div>
</section>
<div class="trust-strip" aria-label="Nuestra atención"><span><TrustIcon kind="evidence"/>Basada en evidencia</span><span><TrustIcon kind="personal"/>Atención personalizada</span><span><TrustIcon kind="online"/>100% en línea</span></div>
<script>
const hero = document.querySelector<HTMLElement>('.hero-copy');
const motion = matchMedia('(prefers-reduced-motion: reduce)');
if (hero && !motion.matches) {
  const selectors = ['.hero-conversation', '.eyebrow', 'h1', '.hero-attribution', '.hero-description', '.hero-actions'];
  const animations: Animation[] = [];
  selectors.forEach((selector, index) => {
    const item = hero.querySelector(selector);
    if (item) animations.push(item.animate([
      {opacity:0, transform:'translateY(12px)'},
      {opacity:1, transform:'translateY(0)'}
    ], {duration:700, delay:index*90, easing:'cubic-bezier(.22,1,.36,1)', fill:'backwards'}));
  });
  // End the entrance immediately if the user requests less motion mid-sequence.
  motion.addEventListener('change', () => {
    if (motion.matches) animations.forEach(animation => animation.finish());
  });
  hero.addEventListener('focusin', () => animations.forEach(animation => animation.finish()), {once:true});
}
</script>
