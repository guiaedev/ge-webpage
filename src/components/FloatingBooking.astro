---
import BookingButton from './BookingButton.astro';
---
<div class="floating-booking" inert aria-hidden="true"><BookingButton label="Agendar sesión"/><svg class="floating-booking-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg></div>
<script>
 // On phones the button shrinks to a round calendar icon; its text stays as the accessible name.
 const floatingIcon = document.querySelector('.floating-booking-icon');
 const floatingLink = document.querySelector('.floating-booking .button');
 if (floatingIcon && floatingLink) { floatingLink.setAttribute('aria-label', 'Agendar sesión'); floatingLink.append(floatingIcon); }
 const floating = document.querySelector<HTMLElement>('.floating-booking');
 const source = document.querySelector('.hero-actions .button');
 if (floating && source) {
   const footerButton = document.querySelector('.footer-mobile-booking .button');
   const mobile = matchMedia('(max-width:760px)');
   const update = () => {
     const footerVisible = mobile.matches && footerButton && footerButton.getBoundingClientRect().top <= (window.visualViewport?.height ?? innerHeight) + 16;
     const visible = source.getBoundingClientRect().bottom <= 0 && !footerVisible;
     floating.classList.toggle('is-visible', visible);
     floating.inert = !visible;
     floating.setAttribute('aria-hidden', String(!visible));
   };
   const observer = new IntersectionObserver(update);
   observer.observe(source);
   if (footerButton) observer.observe(footerButton);
   mobile.addEventListener('change', update);
   // Intersection boundaries alone can miss the handoff during mobile scrolling.
   let pending = false;
   const scheduleUpdate = () => {
     if (pending) return;
     pending = true;
     requestAnimationFrame(() => { pending = false; update(); });
   };
   window.addEventListener('scroll', scheduleUpdate, {passive:true});
   window.addEventListener('resize', scheduleUpdate, {passive:true});
   window.visualViewport?.addEventListener('resize', scheduleUpdate);
   window.visualViewport?.addEventListener('scroll', scheduleUpdate);
   window.addEventListener('pageshow', update);
   update();
 }
</script>
<style>
 .floating-booking{position:fixed;right:max(24px,env(safe-area-inset-right));bottom:calc(24px + env(safe-area-inset-bottom));z-index:10;opacity:0;visibility:hidden;transform:translateY(12px);pointer-events:none;transition:opacity .25s ease,transform .25s ease,visibility .25s}
 .floating-booking.is-visible{opacity:1;visibility:visible;transform:translateY(0);pointer-events:auto}
 .floating-booking :global(.button){box-shadow:0 5px 22px #263d3226;border:1px solid #ffffff55}
 .floating-booking-icon{display:none}
 @media(max-width:760px){.floating-booking{right:max(16px,env(safe-area-inset-right));bottom:calc(16px + env(safe-area-inset-bottom))}.floating-booking :global(.button){display:grid;place-items:center;width:56px;height:56px;min-height:0;padding:0;border-radius:50%;font-size:0;gap:0}.floating-booking :global(.button > span){display:none}.floating-booking :global(.floating-booking-icon){display:block}}
 @media(prefers-reduced-motion:reduce){.floating-booking{transition:none;transform:none}}
</style>
