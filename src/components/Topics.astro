---
import {topics} from '../data/site';
---
<section class="topics-section wrap section" aria-labelledby="topics-title"><div class="section-heading"><h2 id="topics-title">¿Qué te gustaría trabajar?</h2><p>Cada proceso empieza con lo que hoy necesitas.</p></div><div class="topic-grid">{topics.map((topic,index)=><article class:list={['topic-card',topic.color]}><span class="topic-number" aria-hidden="true">0{index+1}</span><div><h3>{topic.title}</h3><p>{topic.text}</p></div><button class="circle-button" data-topic={index} aria-label={`Conoce más sobre ${topic.title}`}><span aria-hidden="true">→</span></button></article>)}</div></section>
{topics.map((topic,index)=><dialog id={`topic-${index}`} class="content-dialog" aria-labelledby={`topic-title-${index}`}><button class="dialog-close" data-close aria-label="Cerrar">×</button><p class="eyebrow">Un espacio para ti</p><h2 id={`topic-title-${index}`}>{topic.title}</h2><p>{topic.detail}</p><a class="button primary" href="#reservar" data-booking>Conversemos <span aria-hidden="true">↗</span></a></dialog>)}
