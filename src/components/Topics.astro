---
import {topics} from '../data/site';
import ConversationMotion from './ConversationMotion.astro';
import TopicAtmosphere from './TopicAtmosphere.astro';
import Mark from './Mark.astro';
---
<section class="topics-section wrap section" aria-labelledby="topics-title"><div class="section-heading" data-reveal><h2 id="topics-title">Un paso a la vez, con acompañamiento.</h2><p>Cada proceso empieza con lo que hoy necesitas.</p></div><div class="topic-grid" data-reveal-group>{topics.map((topic,index)=><article class:list={['topic-card',topic.color]}><div class:list={['topic-illustration', {'topic-art-full': topic.image, 'topic-art-pending': topic.slice === undefined && !topic.image}]} aria-hidden="true">{topic.slice !== undefined
 ? <><img src="assets/topics-storybook.webp" width="1536" height="1024" alt="" loading="lazy" decoding="async" style={`--art-left: ${[-7.7731,-111.7647,-215.1261][topic.slice]}%`} />{topic.slice === 1 ? <ConversationMotion/> : <TopicAtmosphere kind={topic.slice === 0 ? 'breath' : 'light'}/>}</>
 : topic.image ? <img src={`assets/${topic.image}`} alt="" loading="lazy" decoding="async"/> : <Mark/>}</div><div class="topic-copy"><h3>{topic.title}</h3><p>{topic.text}</p></div><button class="circle-button" data-topic={index} aria-label={`Conoce más sobre ${topic.title}`}><span aria-hidden="true">→</span></button></article>)}</div></section>
{topics.map((topic,index)=><dialog id={`topic-${index}`} class="content-dialog" aria-labelledby={`topic-title-${index}`}><button class="dialog-close" data-close aria-label="Cerrar">×</button><p class="eyebrow">Un espacio para ti</p><h2 id={`topic-title-${index}`}>{topic.title}</h2><p>{topic.detail}</p><a class="button primary" href="#reservar" data-booking>Conversemos <span aria-hidden="true">↗</span></a></dialog>)}

