---
import {resources} from '../data/site';
---
<section id="recursos" class="resources-section wrap section" aria-labelledby="resources-title">
 <div class="resources-heading" data-reveal><p class="eyebrow">Para acompañar tu proceso</p><h2 id="resources-title">Recursos</h2><p>Materiales gratuitos para acompañar tu bienestar emocional, entre sesiones o por tu cuenta.</p></div>
 <div class="resource-grid" data-reveal-group>
  {resources.map(resource => <article class:list={['resource-card', resource.tone]}>
   <div class:list={["resource-art", {"resource-document": resource.file && resource.image, "resource-reel": !!resource.url}]}>{resource.image
    ? <img src={`assets/${resource.image}`} alt="" loading="lazy"/>
    : <div class="resource-placeholder" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5z"/><circle cx="9" cy="9.5" r="1.6"/><path d="m20 15.5-4.5-4.5L6 20"/></svg><span>Ilustración próximamente</span></div>}</div>
   <div class="resource-body">
    <p class="resource-meta"><span>{resource.format}</span><span>Gratis</span></p>
    <h3>{resource.title}</h3>
    <p>{resource.description}</p>
    {resource.url
     ? <button class="button primary resource-download" data-instagram-open>Ver reel <span aria-hidden="true">▷</span></button>
     : resource.file
     ? <a class="button primary resource-download" href={`assets/recursos/${resource.file}`} download>Descargar gratis <span aria-hidden="true">↓</span></a>
     : <span class="resource-soon">Disponible próximamente</span>}
   </div>
  </article>)}
 </div>
</section>

<style>
/* Keep the portrait intact against the approved watercolor paper. */
.resource-reel{overflow:hidden;isolation:isolate;background:var(--sand) url('/assets/recursos/reel-watercolor-background.webp') center/cover;aspect-ratio:4/3}
.resource-reel img{inset:7% auto auto 50%;transform:translateX(-50%);width:auto;height:86%;max-width:90%;object-fit:contain;padding:0;border:4px solid #faf7f0;box-shadow:0 5px 14px #403d3026}
.resource-document{margin:14px 14px 0;border-radius:14px;background:#f4eee3;overflow:hidden}
.resource-document img{inset:18px;width:calc(100% - 36px);height:calc(100% - 36px);object-fit:contain;filter:drop-shadow(0 5px 8px #423e2d20)}
</style>

<dialog class="instagram-dialog" aria-labelledby="instagram-title">
 <button class="dialog-close" data-close aria-label="Cerrar">×</button>
 <h2 id="instagram-title">En Instagram</h2>
 <div class="instagram-player"></div>
 <a href="https://www.instagram.com/reel/DeArHFpJXTq/" target="_blank" rel="noopener">Ver en Instagram ↗</a>
</dialog>
<style>
.instagram-dialog{width:min(460px,calc(100vw - 24px),max(320px,calc((100dvh - 230px)*.5625 + 24px)));max-height:calc(100dvh - 24px);padding:0;border:1px solid var(--line);border-radius:20px;background:var(--ivory);overflow:auto;overscroll-behavior:contain}
.instagram-dialog::backdrop{background:#17251dcc}
.instagram-dialog h2{font-size:1.35rem;margin:0;padding:16px 54px 16px 18px}
.instagram-dialog .dialog-close{top:8px;right:8px;width:40px;height:40px;z-index:1}
.instagram-player{margin:0 10px;background:white;border-radius:12px;overflow:hidden}
.instagram-player :global(iframe){display:block;width:100%;height:auto;aspect-ratio:1 / 2.15;min-height:580px;border:0;background:white}
.instagram-dialog>a{display:block;text-align:center;padding:14px 16px;margin:0;text-decoration:underline;font-size:.8rem;min-height:44px}
@media(max-width:480px){.instagram-dialog{width:calc(100vw - 16px);max-height:calc(100dvh - 16px);border-radius:16px}.instagram-player{margin-inline:6px}.instagram-dialog h2{padding-block:12px}.instagram-player :global(iframe){min-height:0;aspect-ratio:1 / 2.15}}
</style>
<script>
const reelDialog = document.querySelector<HTMLDialogElement>('.instagram-dialog')!;
const reelButton = document.querySelector<HTMLButtonElement>('[data-instagram-open]');
reelButton?.addEventListener('click', () => {
 const frame = document.createElement('iframe');
 frame.src = 'https://www.instagram.com/reel/DeArHFpJXTq/embed/';
 frame.title = 'Reel de Guía Existencial del 2 de octubre de 2026';
 frame.allow = 'autoplay; encrypted-media; fullscreen; picture-in-picture';
 frame.allowFullscreen = true;
 reelDialog.querySelector('.instagram-player')!.replaceChildren(frame);
 reelDialog.showModal();
});
reelDialog.addEventListener('close', () => {reelDialog.querySelector('.instagram-player')!.replaceChildren();reelButton?.focus();});
</script>
