---
import {resources} from '../data/site';
import MiaStory from './MiaStory.astro';
---
<section id="recursos" class="resources-section wrap section" aria-labelledby="resources-title">
 <div class="resources-heading" data-reveal><p class="eyebrow">Para acompañar tu proceso</p><h2 id="resources-title">Recursos</h2><p>Materiales gratuitos para acompañar tu bienestar emocional, entre sesiones o por tu cuenta.</p></div>
 <div class="resource-grid" data-reveal-group>
  {resources.map(resource => <article class:list={['resource-card', resource.tone]}>
   <div class:list={["resource-art", {"resource-document": resource.file && resource.image, "resource-link-art": !!resource.url}]}>{resource.image
    ? <img src={`assets/${resource.image}`} srcset={resource.url ? `assets/${resource.image} 720w, assets/${resource.image.replace('-720', '-1200')} 1200w` : undefined} sizes={resource.url ? '(max-width: 640px) 92vw, 360px' : undefined} alt="" loading="lazy"/>
    : <div class="resource-placeholder" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5z"/><circle cx="9" cy="9.5" r="1.6"/><path d="m20 15.5-4.5-4.5L6 20"/></svg><span>Ilustración próximamente</span></div>}</div>
   <div class="resource-body">
    <p class="resource-meta"><span>{resource.format}</span></p>
    <h3>{resource.title}</h3>
    <p>{resource.description}</p>
    {resource.url
     ? <a class="resource-download resource-link" href={resource.url} target="_blank" rel="noopener">Ver perfil <span aria-hidden="true">↗</span></a>
     : resource.file
     ? <a class="resource-download resource-link" href={`assets/recursos/${resource.file}`} download>Descargar <span aria-hidden="true">↓</span></a>
     : <span class="resource-soon">Disponible próximamente</span>}
   </div>
  </article>)}
  <MiaStory/>
 </div>
</section>

<style>
.resource-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;max-width:1200px}
/* One picture size for every card: full-bleed 4:3, flush with the card top. */
.resource-grid :global(.resource-art){aspect-ratio:4/3;margin:0;border-radius:0}
.resource-grid :global(.resource-body){padding:20px 18px 22px}
.resource-grid :global(.resource-body h3){font-size:1.4rem;text-align:center}
/* The whole card is the link (owner, 15 Oct 2026): one real link or button per
   card, stretched over it with ::after, so keyboards and screen readers still
   meet a single named action. A quiet foot line replaces the black buttons. */
.resource-grid :global(.resource-card){position:relative;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}
@media(hover:hover){.resource-grid :global(.resource-card:has(.resource-link):hover){transform:translateY(-4px);box-shadow:0 14px 30px #423e2d1a;border-color:#d9ccb6}}
.resource-grid :global(.resource-link){align-self:stretch;display:flex;align-items:center;gap:8px;margin-top:auto;padding:14px 0 0;border:0;border-top:1px solid #dfd3bf;border-radius:0;background:none;font:500 .9rem var(--sans);color:var(--ink);text-align:left;cursor:pointer}
.resource-grid :global(.resource-link)::after{content:"";position:absolute;inset:0;border-radius:22px;z-index:1}
.resource-grid :global(.resource-card:hover .resource-link){text-decoration:underline;text-underline-offset:4px}
.resource-grid :global(.resource-link:focus-visible){outline:none}
.resource-grid :global(.resource-link:focus-visible)::after{outline:2px solid var(--green);outline-offset:3px}
@media(max-width:1000px){.resource-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){.resource-grid{grid-template-columns:1fr}}
/* Link cards (Instagram): the illustration fills the art area, painted edge to edge. */
.resource-link-art{overflow:hidden}
.resource-link-art img{inset:0;width:100%;height:100%;object-fit:cover;object-position:center;padding:0}
.resource-document{background:#f4eee3;overflow:hidden}
.resource-document img{inset:18px;width:calc(100% - 36px);height:calc(100% - 36px);object-fit:contain;filter:drop-shadow(0 5px 8px #423e2d20)}
</style>
