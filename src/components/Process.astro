<section id="enfoque" class="process wrap section" aria-labelledby="process-title"><h2 id="process-title">Un paso a la vez, con acompañamiento.</h2><ol class="steps"><li><span>01</span><div><h3>Conversemos</h3><p>Hablemos sobre lo que estás viviendo y lo que necesitas.</p></div></li><li><span>02</span><div><h3>Encuentra tu espacio</h3><p>Conoce al equipo y el enfoque de nuestro acompañamiento.</p></div></li><li><span>03</span><div><h3>Avanza a tu ritmo</h3><p>Trabaja en habilidades que puedas llevar a tu vida diaria.</p></div></li></ol><details class="approach"><summary>Conoce nuestros modelos de terapia <span aria-hidden="true">+</span></summary><div class="approach-grid"><article><h3>Terapia Cognitivo-Conductual</h3><p>Identificar patrones de pensamiento y conducta y desarrollar herramientas prácticas.</p></article><article><h3>Terapia de Esquemas</h3><p>Comprender y transformar patrones que se formaron temprano y siguen operando hoy.</p></article><article><h3>Aceptación y Compromiso</h3><p>Construir otra relación con tus emociones y avanzar hacia lo que importa.</p></article></div></details></section>
<script>
const section = document.querySelector<HTMLElement>('#enfoque');
const preference = matchMedia('(prefers-reduced-motion: reduce)');
if (section) {
  const reveals: Animation[] = [];
  let observer: IntersectionObserver | undefined;
  if ('IntersectionObserver' in window && !preference.matches) {
    observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      section.querySelectorAll(':scope > h2, .steps li, .approach').forEach((item, index) => {
        reveals.push(item.animate([
          { opacity: 0, transform: 'translateY(18px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ], { duration: 750, delay: index * 110, easing: 'cubic-bezier(.22,1,.36,1)' }));
      });
      observer?.disconnect();
    }, { threshold: .18 });
    observer.observe(section);
  }
  const details = section.querySelector<HTMLDetailsElement>('.approach')!;
  const summary = details.querySelector('summary')!;
  let expanded = details.open;
  let transition: Animation | undefined;
  const settle = () => {
    details.open = expanded;
    details.style.overflow = '';
    transition = undefined;
  };
  summary.addEventListener('click', event => {
    event.preventDefault();
    const from = details.getBoundingClientRect().height;
    transition?.cancel();
    expanded = !expanded;
    details.dataset.expanded = String(expanded);
    if (preference.matches || !details.animate) { settle(); return; }
    details.open = true;
    const to = expanded ? details.getBoundingClientRect().height : summary.getBoundingClientRect().height + 2;
    details.style.overflow = 'hidden';
    transition = details.animate({height:[`${from}px`, `${to}px`]}, {
      duration: 480, easing: 'cubic-bezier(.22,1,.36,1)'
    });
    transition.onfinish = settle;
  });
  window.addEventListener('resize', () => { if (transition) { transition.cancel(); settle(); } });
  preference.addEventListener('change', () => {
    if (!preference.matches) return;
    observer?.disconnect();
    reveals.forEach(animation => animation.finish());
    transition?.cancel();
    settle();
  });
}
</script>
