---
import Mark from './Mark.astro';
import BookingButton from './BookingButton.astro';
// `current` names the page to mark in the nav; inner pages other than Nosotras pass none.
// The home page drops the header booking button: the hero CTA and the floating button cover it.
const {inner = false, current = inner ? 'nosotras' : undefined} = Astro.props;
const home = inner ? 'index.html' : ''; 
---
<header class:list={["site-header", "wrap", {"home-header": !inner}]}>
 <a href={`${home}#inicio`} class="brand" aria-label="Guía Existencial, inicio"><Mark/>Guía Existencial</a>
 <button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menú <span aria-hidden="true">☰</span></button>
 <nav id="navigation" aria-label="Navegación principal"><a href={`${home}#enfoque`}>Nuestro enfoque</a><a href="nosotras/" aria-current={current === 'nosotras' ? 'page' : undefined}>Nosotras</a><a href={`${home}#equipo`}>Equipo</a><a href={`${home}#recursos`}>Recursos</a><a href={`${home}#preguntas`}>Preguntas frecuentes</a>{inner && <BookingButton label="Agendar sesión" variant="outline"/>}</nav>
</header>

<script>
const toggle = document.querySelector('.menu-toggle');
const navigation = document.querySelector('#navigation');
if (location.pathname.includes('/nosotras')) {
 toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); navigation?.classList.toggle('is-open', open); });
 document.addEventListener('keydown', e => {if(e.key === 'Escape'){toggle?.setAttribute('aria-expanded','false');navigation?.classList.remove('is-open');}});
}
</script>

<style>
/* Shared header geometry keeps the logo fixed across home and inner pages. */
.site-header::before{content:'';position:absolute;inset:0 auto 0 50%;width:100vw;transform:translateX(-50%);background:#faf7ef;border-bottom:1px solid #d6dcca;box-shadow:0 3px 12px #30443808;z-index:-1;pointer-events:none}
.site-header .brand{flex-shrink:0}
@media(min-width:761px){.site-header{gap:24px}.site-header nav{color:#263f33}}
@media(min-width:761px) and (max-width:1100px){.site-header{gap:12px}}
@media(min-width:1100px){.site-header{width:82%;max-width:none}}
</style>
