---
import {team, site, bookingPolicies} from '../data/site';
import Testimonials from './Testimonials.astro';

/* The questions that decide whether someone books. Session length and the
   cancellation agreements are read from bookingPolicies (site.ts), the same
   text the booking dialog shows, so the two never disagree. Price is left out
   until the practice publishes one. The confidentiality and «¿es para mí?»
   answers are drafts for the practice to confirm (15 October 2026). */
// Team members with a full bio get a profile dialog (opened by «Conocer más» on their card).
// Only people shown on the home grid: the dialog uses their watercolor avatar.
const profiles = team.flatMap(({avatar, name, profile, ...person}) => profile && person.home !== false ? [{avatar, name, profile: profile as {title: string; subtitle: string; quote?: string; bio: string[]; focus: string[]; closing?: string; cta: string}}] : []);
const policy = (title: string) => bookingPolicies.find(p => p.title === title)?.text ?? '';
const faqs = [
  { category: 'Tu proceso', question: '¿Qué terapia es adecuada para mí?', answer: 'No necesitas elegir un modelo antes de acercarte. Conversar con el equipo sobre lo que buscas puede ayudarte a conocer el enfoque y valorar si se ajusta a tus necesidades.' },
  { category: 'Tu proceso', question: '¿Cómo sé si la terapia es para mí?', answer: 'No hace falta estar en crisis para empezar. Si algo te pesa desde hace tiempo, se repite o simplemente quieres entenderte mejor, una primera sesión sirve para hablarlo y decidir juntos si este es el espacio adecuado.' },
  { category: 'Tu espacio', question: '¿La atención es en línea?', answer: 'Sí. Guía Existencial ofrece psicoterapia en línea. Al coordinar tu sesión, confirma con el equipo la plataforma, el horario y los detalles de conexión.' },
  { category: 'Tu espacio', question: '¿Atienden a menores de edad?', answer: 'No. A través de esta plataforma atendemos únicamente a personas adultas, a partir de los 18 años.' },
  { category: 'Tu espacio', question: '¿Puedo tomar terapia si vivo fuera de México?', answer: 'Sí. Como la atención es en línea, puedes tomar tus sesiones desde cualquier país, siempre que la terapia sea en español. Al agendar, revisa la diferencia de horario con México. En caso de emergencia, comunícate con los servicios de emergencia del país donde te encuentres.' },
  { category: 'Tu sesión', question: '¿Cuánto dura una sesión?', answer: policy('Puntualidad') },
  { category: 'Tus acuerdos', question: '¿Puedo cancelar o reprogramar?', answer: `${policy('Cancelaciones y cambios')} ${policy('Inasistencias')}` },
  { category: 'Tu privacidad', question: '¿Lo que comparto es confidencial?', answer: 'Sí. Lo que compartes en sesión se trata con confidencialidad profesional. Las únicas excepciones son las que marca la ética de la psicología, como un riesgo para tu vida o la de otras personas, y en ese caso lo hablaríamos contigo.' },
  { category: 'Tu primer paso', question: '¿Cómo puedo agendar?', answer: 'Usa el botón “Agendar una sesión”. Desde ahí podrás acceder al calendario cuando esté disponible o consultar al equipo por los canales de contacto actuales.' },
];
const faqGroups = [
  {label: 'Tu proceso', categories: ['Tu proceso', 'Tu privacidad']},
  {label: 'Tu espacio', categories: ['Tu espacio']},
  {label: 'Tu primera sesión', categories: ['Tu sesión', 'Tus acuerdos', 'Tu primer paso']},
];
/* «¿Otra pregunta?» opens WhatsApp once the practice's number is set
   (site.whatsapp), with the first line already written; until then it is the
   contact email. */
const whatsapp = site.whatsapp
  ? `https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola, tengo una pregunta sobre la terapia en Guía Existencial.')}`
  : null;
/* The same questions as structured data, so search engines can show them. */
const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
});
---
<section id="equipo" class="team-section section"><div class="botanical-viewport team-botanical" aria-hidden="true"><picture><source type="image/webp" srcset="assets/team-botanical-960.webp 960w, assets/team-botanical-1536.webp 1536w" sizes="100vw"/><img src="assets/team-botanical-1536.webp" alt="" loading="lazy" width="1536" height="1024"/></picture></div><div class="wrap"><p class="eyebrow" data-reveal>Nuestro equipo clínico</p><h2 data-reveal>Rigor científico.<br/> <em>Calidez humana.</em></h2><div class="team-grid" data-reveal-group>{team.filter(person=>person.home!==false).map(person=><article class="team-card"><span class="initials profile-avatar"><img src={`assets/${person.avatar}-avatar-watercolor-v2.webp`} alt={`Avatar ilustrado de ${person.name}`} width="104" height="104" loading="lazy"/></span><h3>{person.name}</h3><p class="role">{person.role}</p><p>{person.note}</p>{person.profile && <button class="team-more" type="button" data-profile={person.avatar} aria-haspopup="dialog">Conocer más <span aria-hidden="true">→</span></button>}</article>)}</div><p data-reveal class="team-note">Formación continua, supervisión y trabajo en equipo.</p></div></section>
{profiles.map(({avatar, name, profile}) => <dialog id={`profile-${avatar}`} class="content-dialog profile-dialog" aria-labelledby={`profile-title-${avatar}`}>
 <button class="dialog-close" data-close aria-label="Cerrar">×</button>
 <header class="profile-head"><img src={`assets/${avatar}-avatar-watercolor-v2.webp`} alt={`Avatar ilustrado de ${name}`} width="88" height="88" loading="lazy"/><div><p class="eyebrow">Nuestro equipo</p><h2 id={`profile-title-${avatar}`}>{profile.title}</h2><p class="profile-subtitle">{profile.subtitle}</p></div></header>
 {profile.quote && <blockquote class="profile-quote">{profile.quote}</blockquote>}
 {profile.bio.map(text => <p>{text}</p>)}
 <ul class="profile-focus" aria-label="Acompaña principalmente">{profile.focus.map(item => <li>{item}</li>)}</ul>
 {profile.closing && <p class="profile-closing">{profile.closing}</p>}
 <a class="button primary" href={site.bookingUrl || '#reservar'} data-booking data-booking-tab="first">{profile.cta} <span aria-hidden="true">↗</span></a>
</dialog>)}
<Testimonials/>
<section id="preguntas" class="faq wrap section" aria-labelledby="faq-title">
  <div class="faq-intro"><p class="eyebrow">Antes de empezar</p><h2 id="faq-title">Resolvemos<br/><em>tus dudas.</em></h2><p class="faq-lead">Un poco de claridad para dar<br class="desktop-break"/> tu siguiente paso.</p>

  </div>
  <div class="faq-topics">
    <div class="faq-tabs" role="tablist" aria-label="Temas de preguntas frecuentes" hidden>
      {faqGroups.map((group, i) => <button type="button" role="tab" id={`faq-tab-${i}`} aria-controls={`faq-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{group.label}</button>)}
    </div>
    {faqGroups.map((group, i) => <div class="faq-topic-panel" id={`faq-panel-${i}`}>
      <h3 class="faq-group-heading">{group.label}</h3>
      <div class="faq-list">{faqs.filter(f => group.categories.includes(f.category)).map((f, j) => <details open={j === 0}><summary><div><h3>{f.question}</h3></div><span class="faq-toggle" aria-hidden="true"></span></summary><div class="faq-answer"><p>{f.answer}</p></div></details>)}</div>
    </div>)}
  </div>
  <aside class="faq-ask" aria-labelledby="faq-ask-title"><span id="faq-ask-title">¿Otra pregunta?</span> <a href={whatsapp || `mailto:${site.contactEmail}`} target={whatsapp ? '_blank' : undefined} rel={whatsapp ? 'noopener' : undefined}>Escríbenos <span aria-hidden="true">↗</span></a></aside>
  <script type="application/ld+json" set:html={faqSchema}/>
</section>
<script>
const faq = document.querySelector<HTMLElement>('#preguntas');
if (faq) {
  const tabs = [...faq.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
  const panels = [...faq.querySelectorAll<HTMLElement>('.faq-topic-panel')];
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const topics = faq.querySelector<HTMLElement>('.faq-topics')!;
  const ease = 'cubic-bezier(.22,1,.36,1)';
  let active = -1;
  let panelMotion: Animation | undefined;
  let sizeMotion: Animation | undefined;
  const accordionStops: Array<() => void> = [];
  const activate = (index: number) => {
    if (index === active) return;
    const previous = active;
    const startHeight = topics.getBoundingClientRect().height;
    panelMotion?.cancel(); sizeMotion?.cancel();
    accordionStops.forEach(stop => stop());
    tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
    panels.forEach((panel, i) => { panel.hidden = i !== index; });
    active = index;
    if (previous !== -1 && !reduced.matches) {
      const direction = index > previous ? 1 : -1;
      panelMotion = panels[index].animate(
        [{opacity:0, transform:`translate(${direction * 10}px, 5px)`}, {opacity:1, transform:'none'}],
        {duration:320, easing:ease});
      sizeMotion = topics.animate(
        {height:[`${startHeight}px`, `${topics.getBoundingClientRect().height}px`]},
        {duration:320, easing:ease});
    }
  };
  faq.classList.add('faq-tabbed');
  faq.querySelector<HTMLElement>('.faq-tabs')!.hidden = false;
  panels.forEach((panel, i) => { panel.setAttribute('role', 'tabpanel'); panel.setAttribute('aria-labelledby', tabs[i].id); });
  activate(0);
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => activate(i));
    tab.addEventListener('keydown', event => {
      let next = i;
      if (event.key === 'ArrowRight') next = (i + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') next = (i + tabs.length - 1) % tabs.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = tabs.length - 1;
      else return;
      event.preventDefault(); activate(next); tabs[next].focus();
    });
  });
  const controllers = new Map<HTMLDetailsElement, {set: (open: boolean) => void}>();
  panels.forEach(panel => panel.querySelectorAll('details').forEach(detail => {
    const summary = detail.querySelector('summary')!;
    const answer = detail.querySelector<HTMLElement>('.faq-answer')!;
    let target = detail.open;
    let motion: Animation | undefined;
    let answerMotion: Animation | undefined;
    const settle = () => {
      motion?.cancel(); answerMotion?.cancel();
      motion = undefined; answerMotion = undefined;
      detail.open = target;
      detail.style.overflow = '';
      detail.dataset.expanded = String(target);
    };
    const set = (open: boolean) => {
      const start = detail.getBoundingClientRect().height;
      motion?.cancel(); answerMotion?.cancel();
      target = open;
      detail.dataset.expanded = String(open);
      if (reduced.matches || panel.hidden) { settle(); return; }
      detail.open = true;
      const end = open ? detail.getBoundingClientRect().height : summary.getBoundingClientRect().height + 1;
      detail.style.overflow = 'hidden';
      motion = detail.animate({height:[`${start}px`, `${end}px`]}, {duration:340, easing:ease});
      motion.onfinish = settle;
      answerMotion = answer.animate(
        open ? [{opacity:0, transform:'translateY(-5px)'}, {opacity:1, transform:'none'}] : [{opacity:1}, {opacity:0}],
        {duration:open ? 280 : 160, easing:ease});
    };
    controllers.set(detail, {set});
    accordionStops.push(settle);
    summary.addEventListener('click', event => {
      event.preventDefault();
      const next = !target;
      if (next) panel.querySelectorAll('details').forEach(other => {
        if (other !== detail) controllers.get(other)?.set(false);
      });
      set(next);
    });
  }));
  const stopMotion = () => {
    panelMotion?.cancel(); sizeMotion?.cancel();
    accordionStops.forEach(stop => stop());
  };
  reduced.addEventListener('change', stopMotion);
  window.addEventListener('resize', stopMotion);

}
</script>
<style>
.faq{grid-template-areas:"intro topics" "contact topics";grid-template-rows:auto 1fr;row-gap:30px;column-gap:clamp(32px,5vw,64px)}
.faq-intro{grid-area:intro;padding-top:0;position:static}
.faq h2{font-size:clamp(2.8rem,4vw,3.6rem);margin:18px 0;line-height:1.05}
.faq>.faq-ask{grid-area:contact;display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 10px;margin:0;padding:0;max-width:none;border:0;border-radius:0;background:none;font-size:.95rem}
.faq-ask a{display:inline-flex;gap:8px;align-items:baseline;border-bottom:1px solid #8a9b78;padding-bottom:2px;transition:color .2s,border-color .2s}
.faq-ask a:hover{color:#65765b;border-color:currentColor}
.faq-topics{grid-area:topics;min-width:0}
.faq-tabs{display:flex;gap:clamp(16px,2.8vw,40px);margin-bottom:12px;border-bottom:1px solid #cdd4c4}
.faq-tabs[hidden],.faq-topic-panel[hidden]{display:none}
.faq-tabs button{position:relative;flex:0 1 auto;min-height:48px;padding:0 0 14px;border:0;border-radius:0;background:none;color:#74806a;font:400 clamp(1rem,1.6vw,1.3rem)/1.3 var(--serif);cursor:pointer;transition:color .25s}
.faq-tabs button::after{content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:#7d916d;transform:scaleX(0);transform-origin:left;transition:transform .3s cubic-bezier(.22,1,.36,1)}
.faq-tabs button[aria-selected="true"]{color:#304438}
.faq-tabs button[aria-selected="true"]::after{transform:scaleX(1)}
.faq-tabs button:hover{color:#304438}
.faq-tabs button:focus-visible{outline:2px solid #8a9b78;outline-offset:5px}
.faq-group-heading{margin:20px 0 12px}
.faq-tabbed .faq-group-heading{display:none}
.faq-topics .faq-list{gap:0}
.faq-topics .faq-list details,.faq-topics .faq-list details[open],.faq-topics .faq-list details:hover{position:relative;border:0;border-bottom:1px solid #cdd4c4;border-radius:0;background:transparent;box-shadow:none}
.faq-topics .faq-list summary{min-height:82px;padding:22px 6px;gap:20px;border-radius:0}
.faq-topics .faq-list summary h3{font:400 clamp(1.25rem,1.8vw,1.65rem)/1.35 var(--serif);letter-spacing:-.015em}
.faq-topics .faq-list .faq-answer{position:relative;isolation:isolate}
.faq-topics .faq-list .faq-answer::before{content:"";position:absolute;inset:-8px -10px 4px;z-index:-1;pointer-events:none;background:radial-gradient(ellipse at 20% 42%,#dbe1cc66,transparent 68%),radial-gradient(ellipse at 72% 55%,#e0e5d070,transparent 70%);mask-image:linear-gradient(transparent,#000 22%,#000 72%,transparent)}
.faq-topics .faq-list .faq-answer p{padding:2px 40px 30px 6px;font-size:.96rem;line-height:1.85}
.faq-topics .faq-list .faq-toggle,.faq-topics .faq-list details[open] .faq-toggle,.faq-topics .faq-list details[data-expanded="false"] .faq-toggle{position:relative;display:block;width:22px;height:22px;flex:none;border:0;border-radius:0;background:none;color:#304438;transform:none}
.faq-toggle::before,.faq-toggle::after{content:"";position:absolute;background:currentColor;inset:10px 3px auto;height:1.5px;transition:transform .25s,opacity .25s}
.faq-toggle::after{transform:rotate(90deg)}
.faq-list details[open] .faq-toggle::after{transform:rotate(0deg);opacity:0}
.faq-list details[data-expanded="false"] .faq-toggle::after{transform:rotate(90deg);opacity:1}
@media(max-width:760px){.faq{grid-template-areas:"intro" "topics" "contact";grid-template-rows:auto;row-gap:26px}.faq-tabs{gap:20px}.faq-tabs button{font-size:1.05rem;min-height:48px;padding-bottom:12px}.faq-topics .faq-list summary{padding:20px 2px;gap:14px;min-height:76px}.faq-topics .faq-list summary h3{font-size:1.3rem}.faq-topics .faq-list .faq-answer p{padding:0 12px 26px 2px;font-size:.95rem}.faq>.faq-ask{padding-top:2px}}
@media(prefers-reduced-motion:reduce){.faq-tabs button,.faq-tabs button::after,.faq-toggle::before,.faq-toggle::after,.faq-ask a{transition:none}}
</style>
