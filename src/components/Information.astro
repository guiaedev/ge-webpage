---
import {team} from '../data/site';
import Testimonials from './Testimonials.astro';
---
<section id="equipo" class="team-section section"><div class="botanical-viewport team-botanical" aria-hidden="true"><picture><source type="image/webp" srcset="assets/team-botanical-960.webp 960w, assets/team-botanical-1536.webp 1536w" sizes="100vw"/><img src="assets/team-botanical-1536.webp" alt="" loading="lazy" width="1536" height="1024"/></picture></div><div class="wrap"><p class="eyebrow" data-reveal>Nuestro equipo clínico</p><h2 data-reveal>Rigor científico.<br/> <em>Calidez humana.</em></h2><div class="team-grid" data-reveal-group>{team.map(person=><article class="team-card"><span class="initials profile-avatar"><img src={`assets/${person.avatar}-avatar-watercolor-v2.webp`} alt={`Avatar ilustrado de ${person.name}`} width="104" height="104" loading="lazy"/></span><h3>{person.name}</h3><p class="role">{person.role}</p><p>{person.note}</p></article>)}</div><p data-reveal class="team-note">Formación continua, supervisión y trabajo en equipo.</p></div></section>
<Testimonials/>
<section id="preguntas" class="faq wrap section" aria-labelledby="faq-title">
  <div class="faq-intro" data-reveal><p class="eyebrow">Antes de empezar</p><h2 id="faq-title">Resolvemos<br/><em>tus dudas.</em></h2><p class="faq-lead">Un poco de claridad para dar<br class="desktop-break"/> tu siguiente paso.</p></div>
  <div class="faq-list" data-reveal-group>
    <details open><summary><small aria-hidden="true">01</small><div><p class="faq-category">Tu proceso</p><h3>¿Qué terapia es adecuada para mí?</h3></div><span class="faq-toggle" aria-hidden="true">+</span></summary><div class="faq-answer"><p>No necesitas elegir un modelo antes de acercarte. Conversar con el equipo sobre lo que buscas puede ayudarte a conocer el enfoque y valorar si se ajusta a tus necesidades.</p></div></details>
    <details><summary><small aria-hidden="true">02</small><div><p class="faq-category">Tu espacio</p><h3>¿La atención es en línea?</h3></div><span class="faq-toggle" aria-hidden="true">+</span></summary><div class="faq-answer"><p>Sí. Guía Existencial ofrece psicoterapia en línea. Al coordinar tu sesión, confirma con el equipo la plataforma, el horario y los detalles de conexión.</p></div></details>
    <details><summary><small aria-hidden="true">03</small><div><p class="faq-category">Tu primer paso</p><h3>¿Cómo puedo agendar?</h3></div><span class="faq-toggle" aria-hidden="true">+</span></summary><div class="faq-answer"><p>Usa el botón “Agendar una sesión”. Desde ahí podrás acceder al calendario cuando esté disponible o consultar al equipo por los canales de contacto actuales.</p></div></details>
  </div>
</section>
<script>
const faq = document.querySelector<HTMLElement>('#preguntas');
const reduced = matchMedia('(prefers-reduced-motion: reduce)');
if (faq) {
  const controllers: Array<{element: HTMLDetailsElement; set: (open: boolean) => void}> = [];
  faq.querySelectorAll('details').forEach(element => {
    const summary = element.querySelector('summary')!;
    let target = element.open;
    let animation: Animation | undefined;
    const finish = () => { element.open = target; animation = undefined; element.style.overflow = ''; };
    const set = (open: boolean) => {
      const start = element.getBoundingClientRect().height;
      animation?.cancel();
      target = open;
      element.dataset.expanded = String(open);
      if (reduced.matches || !element.animate) { finish(); return; }
      element.open = true;
      const end = open ? element.getBoundingClientRect().height : summary.getBoundingClientRect().height + 2;
      element.style.overflow = 'hidden';
      animation = element.animate({height:[`${start}px`,`${end}px`]}, {duration:420,easing:'cubic-bezier(.22,1,.36,1)'});
      animation.onfinish = finish;
    };
    controllers.push({element,set});
    summary.addEventListener('click', event => {
      event.preventDefault();
      const next = !target;
      if (next) controllers.forEach(item => { if (item.element !== element) item.set(false); });
      set(next);
    });
    const stop = () => { animation?.cancel(); finish(); };
    reduced.addEventListener('change', stop);
    window.addEventListener('resize', stop);
  });
  if ('IntersectionObserver' in window && !reduced.matches) {
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      [faq.firstElementChild!, ...faq.querySelectorAll('details')].forEach((item,i) => item.animate(
        [{opacity:0,transform:'translateY(18px)'},{opacity:1,transform:'translateY(0)'}],
        {duration:650,delay:i*75,easing:'cubic-bezier(.22,1,.36,1)'}));
      observer.disconnect();
    },{threshold:.12});
    observer.observe(faq);
    reduced.addEventListener('change',()=>{if(reduced.matches){observer.disconnect();faq.getAnimations({subtree:true}).forEach(a=>a.finish());}});
  }
}
</script>
