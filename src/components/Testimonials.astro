---
// Public Facebook recommendations for Guía Existencial, quoted verbatim (emoji omitted).
// Names are shortened to first name + initial; confirm each person's consent before publishing.
const quotes = [
  {text: 'Recomiendo mucho a Jessica. Es muy preparada y su atención es excelente. Te hace sentir en confianza durante las sesiones, hablar con ella se siente muy natural. Lo que más valoro de las sesiones es que no se quedan sólo en escuchar: salgo con herramientas útiles para el día a día. Me ha ayudado mucho en lo que estamos trabajado.', name: 'Carlos H.', date: 'octubre de 2026'},
  {text: 'Llevo un par de años con terapia con jess, no han sido continuos pero siempre regreso cuando ha algún tema que tratar y de verdad que nunca la suelto porque es lo máximo cuando quiero entenderme con una situación! Gracias Jess por tu paciencia y tu amor a lo que haces y sobre todo gracias por ayudarme tanto!', name: 'Anahi H.', date: 'octubre de 2026'},
  {text: 'He tenido la mejor experiencia con Jessica. Me ha dado herramientas, me ha acompañado y me ha ayudado siempre que lo he necesitado. Es muy profesional y empática. Totalmente recomendada. Le confiaría mi salud mental toda la vida.', name: 'Katya R.', date: 'octubre de 2026'},
  {text: 'He trabajado con Jessica y ha sido una persona que me ha apoyado muchísimo en mi proceso. Es excelente escuchando, siempre me hace sentir muy cómoda y en confianza. Estoy muy agradecida por su apoyo y por la manera tan amable y profesional en la que trabaja. ¡La recomiendo mucho!', name: 'Shania H.', date: 'octubre de 2026'},
  {text: 'soy paciente de Jesica y solo tengo cosas bonitas que decir de ella, agradezco el apoyo y la confianza que me hace sentir siempre en terapia', name: 'Cynthia M.', date: 'octubre de 2026'},
  {text: 'Tuve la fortuna de coincidir con Jessica. Una psicóloga excepcional, profecional, humana, sabia y empática. Cada sesión ha dejado algo valioso en mí. Estoy agradecida de haberla encontrado y la recomiendo cada que puedo. Gracias por tanto', name: 'Karina V.', date: 'octubre de 2026'},
  {text: 'Desde hace 3 años coincidí con terapia de Jessica y es de las mejores cosas que me han pasado. Vivi en Canadá y tomaba la sesión desde casa y ahora desde México así que no hay limitantes.', name: 'Brandon I.', date: 'octubre de 2026'},
  {text: 'Estoy muy agradecida de haber encontrado a una psicóloga como ella. Es una profesional muy humana, empática y respetuosa, que te hace sentir escuchada y comprendida desde el primer momento. Cada sesión me ha ayudado a conocerme mejor, entender lo que siento y aprender a afrontar las situaciones de una manera diferente.', name: 'Estefani M.', date: 'octubre de 2026'},
];
---
<section id="testimonios" class="testimonials section" aria-labelledby="testimonials-title">
  <div class="wrap">
    <header class="section-heading">
      <p class="eyebrow">Testimonios</p>
      <h2 id="testimonials-title">Un espacio para sentirte escuchada.</h2>
      <p>Cada proceso es personal. Cada voz, una historia.</p>
    </header>
    <div class="testimonial-track" tabindex="0" role="region" aria-roledescription="carrusel" aria-label="Testimonios" id="testimonial-track">
      {quotes.map((quote, index) => <article class="testimonial-card" role="group" aria-roledescription="diapositiva" aria-label={`${index + 1} de ${quotes.length}`}>
        <span class="quote-mark" aria-hidden="true">“</span>
        <blockquote>{quote.text}</blockquote>
        <div class="quote-credit"><span>{quote.name}</span><small>Recomendación en Facebook · {quote.date}</small></div>
      </article>)}
    </div>
    <div class="testimonial-controls" hidden>
      <button class="testimonial-arrow" data-step="-1" aria-label="Testimonio anterior" aria-controls="testimonial-track">←</button>
      <div class="testimonial-dots">{quotes.map((_, index) => <button data-slide={index} aria-label={`Ver testimonio ${index + 1}`} aria-controls="testimonial-track" aria-current={index === 0 ? 'true' : 'false'}><span/></button>)}</div>
      <button class="testimonial-arrow" data-step="1" aria-label="Testimonio siguiente" aria-controls="testimonial-track">→</button>
    </div>
  </div>
</section>
<style>
.testimonials{position:relative;background:linear-gradient(180deg,var(--ivory),#f4efe5 65%,var(--ivory));overflow:hidden}
.section-heading h2{margin-top:18px}.section-heading>p:last-child{color:var(--muted)}
.testimonial-track{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:8px 0 18px;scroll-padding-inline:0;border-radius:24px}
.testimonial-track::-webkit-scrollbar{display:none}
.testimonial-track::after{content:'';flex:0 0 calc(100% - 44% - 24px)}
.testimonial-card{flex:0 0 44%;scroll-snap-align:start;padding:30px 38px 34px;border:1px solid #d8ccba66;border-radius:24px;background:#f6f0e5;display:flex;flex-direction:column;min-height:300px}
.testimonial-card:nth-child(3n + 2){background:#e8ede2}.testimonial-card:nth-child(3n){background:#f2e7e0}
.quote-mark{font:64px/.9 var(--serif);color:#9b9d86}.testimonial-card blockquote{font:clamp(1.2rem,1.65vw,1.45rem)/1.45 var(--serif);color:var(--heading);margin:8px 0 30px;letter-spacing:-.025em}
.quote-credit{margin-top:auto;border-top:1px solid #a7ac9655;padding-top:18px;color:var(--muted);font-size:.85rem}.quote-credit small{display:block;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;margin-top:4px}
.testimonial-controls{display:flex;align-items:center;justify-content:center;gap:28px;margin-top:18px}.testimonial-controls[hidden]{display:none}
.testimonial-arrow{width:46px;height:46px;border:1px solid #afb49e;border-radius:50%;background:transparent;font-size:1.3rem}.testimonial-arrow:hover{background:var(--mist)}.testimonial-arrow:disabled{opacity:.3;cursor:default}
.testimonial-dots{display:flex;gap:4px}.testimonial-dots button{display:grid;place-items:center;width:32px;height:44px;border:0;background:transparent}.testimonial-dots span{width:6px;height:6px;border-radius:50%;background:#bfc3b2;transition:background .2s,transform .2s}.testimonial-dots [aria-current=true] span{background:var(--green);transform:scale(1.4)}
@media(max-width:760px){.testimonial-track{gap:14px;overflow: auto;border-radius:20px}.testimonial-card{flex-basis:88%;padding:24px;min-height:300px;border-radius:20px}.testimonial-track::after{flex-basis:calc(12% - 14px)}.testimonial-card blockquote{font-size:1.18rem}.testimonials .section-heading{max-width:330px;margin-inline:auto}.testimonial-controls{margin-top:8px}}
</style>
<script>
const section = document.querySelector<HTMLElement>('#testimonios');
if (section) {
  const track = section.querySelector<HTMLElement>('.testimonial-track')!;
  const cards = Array.from(track.querySelectorAll<HTMLElement>('.testimonial-card'));
  const dots = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-slide]'));
  const arrows = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-step]'));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let current = 0;
  const positions = () => cards.map(card => card.getBoundingClientRect().left - track.getBoundingClientRect().left + track.scrollLeft);
  const update = () => {
    const offsets = positions();
    current = offsets.reduce((best, offset, index) => Math.abs(offset - track.scrollLeft) < Math.abs(offsets[best] - track.scrollLeft) ? index : best, 0);
    dots.forEach((dot, index) => dot.setAttribute('aria-current', String(index === current)));
    arrows[0].disabled = current === 0;
    arrows[1].disabled = current === cards.length - 1;
  };
  const go = (index: number) => track.scrollTo({left: positions()[Math.max(0, Math.min(cards.length - 1, index))], behavior: reduced.matches ? 'instant' : 'smooth'});
  dots.forEach((dot, index) => dot.addEventListener('click', () => go(index)));
  arrows.forEach(arrow => arrow.addEventListener('click', () => go(current + Number(arrow.dataset.step))));
  track.addEventListener('keydown', event => {
    if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); go(current + (event.key === 'ArrowRight' ? 1 : -1)); }
  });
  track.addEventListener('scroll', update, {passive: true});
  new ResizeObserver(update).observe(track);
  section.querySelector<HTMLElement>('.testimonial-controls')!.hidden = false;
  update();
}
</script>
